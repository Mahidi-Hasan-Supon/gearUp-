model User {
    id       String     @id @default(uuid())
    name     String
    password String
    email    String @unique
    photoUrl String?
    role     UserRole 
    status   UserStatus @default(ACTIVE)


    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    gear Gear[]
    rental Rental[]
    reviews Review[]
    category Category[]

    @@map("users")
}
